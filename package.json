{
  "name": "llm-wiki-sync",
  "version": "0.9.1",
  "description": "Sync Markdown notes with Notion bidirectionally with explicit conflict protection.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node build.cjs",
    "typecheck": "tsc --noEmit",
    "test:file-name": "node tests/fileName.test.mjs",
    "test:baseline": "node tests/baseline.test.mjs",
    "test:create-page-markdown": "node tests/createPageMarkdown.test.mjs",
    "test:mapping": "node tests/mapping.test.mjs",
    "test:pull": "node tests/pull.test.mjs",
    "test:bulk-push": "node tests/bulkPush.test.mjs",
    "test:markdown-conversion": "node tests/markdownConversion.test.mjs",
    "test:conversion-integration": "node tests/conversionIntegration.test.mjs",
    "test:media-push": "node tests/mediaPush.test.mjs",
    "test": "npm run test:file-name && npm run test:baseline && npm run test:create-page-markdown && npm run test:mapping && npm run test:pull && npm run test:bulk-push && npm run test:markdown-conversion && npm run test:conversion-integration && npm run test:media-push"
  },
  "keywords": [
    "obsidian",
    "notion",
    "sync"
  ],
  "author": "JIHO-0629",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.4"
  }
}
