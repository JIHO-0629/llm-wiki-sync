{
  "name": "llm-wiki-sync",
  "version": "0.8.3",
  "description": "Sync Markdown notes with Notion bidirectionally with explicit conflict protection.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node build.cjs",
    "test:file-name": "node tests/fileName.test.mjs",
    "test:baseline": "node tests/baseline.test.mjs",
    "test:pull": "node tests/pull.test.mjs",
    "test": "npm run test:file-name && npm run test:baseline && npm run test:pull"
  },
  "keywords": [
    "obsidian",
    "notion",
    "sync"
  ],
  "author": "JIHO-0629",
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.23.0",
    "obsidian": "^1.7.2",
    "typescript": "^5.5.4"
  }
}
